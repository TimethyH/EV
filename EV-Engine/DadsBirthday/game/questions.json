// The birthday quiz. Edit this file with Notepad; see DadsBirthday/README.md for every option.
//
// - "left" and "right" are the answers on the left and right screen (as you see them when you face the screens).
// - "correct" says which one is right: "left" or "right".
// - "correctImage" is shown when the right bird is shot, "wrongImage" when the wrong one is. Paths are relative
//   to this folder (put your pictures in game/images). jpg and png both work; big photos are made smaller.
// - "correctMessage" and "wrongMessage" are optional; they appear in the text box after answering.
// - Text between // and the end of a line is a comment and is ignored.
{
  // The title of the start menu.
  "title": "Happy Birthday!",

  // The first message, after waking up on the beach.
  "intro": "Happy birthday! Walk with W A S D, look around with the mouse and shoot with the left mouse button. Turn around and shoot the birthday cake to start the quiz!",

  "questions": [
    {
      "question": "What is the capital of the Netherlands?",
      "left": "Amsterdam",
      "right": "Rotterdam",
      "correct": "left",
      "correctImage": "images/question1_correct.png",
      "wrongImage": "images/question1_wrong.png",
      "correctMessage": "Correct! Amsterdam it is.",
      "wrongMessage": "Nope! Rotterdam has the biggest harbour, but Amsterdam is the capital."
    },
    {
      "question": "How many legs does a spider have?",
      "left": "Six",
      "right": "Eight",
      "correct": "right",
      "correctImage": "images/question2_correct.png",
      "wrongImage": "images/question2_wrong.png"
    },
    {
      "question": "Which of these is a fruit?",
      "left": "Tomato",
      "right": "Carrot",
      "correct": "left",
      "correctImage": "images/question3_correct.png",
      "wrongImage": "images/question3_wrong.png"
    }
  ],

  "finale": {
    // Big text on the left screen after the last question.
    "title": "Happy Birthday Dad!",
    // Shown in the text box at the end, followed by the score.
    "message": "That was the last question. Happy birthday, have a wonderful day!",
    // The pictures on the right screen at the end. Leave the list empty to use every correctImage.
    "images": []
  }
}
